@using Shared.Models.DTOs
@using Web.Services;
@using Microsoft.AspNetCore.Authorization

@page "/prorector"

@* @attribute [Authorize] *@
@inject IGradeService GradeService

<title>Anfragen</title>

<h3>Anfragen</h3>

@foreach (GradeDto grade in grades)
{
    <li class="row listItem align-items-center justify-content-between">
        <div class="col-2">
            <strong>@grade.CreatorName</strong>
        </div>

        <div class="col-2">
            <p>@grade.FirstName @grade.LastName</p>
        </div>

        <div class="col-2">
            <p>@grade.Class</p>
        </div>

        <div class="col-2">
            <p>@grade.Subject</p>
        </div>

        <div class="col-2">
            <p>@grade.Grade</p>
        </div>

        <div class="col-2">
            <button class="btn btn-sm btn-danger">Ablehnen</button>
            <button class="btn btn-sm btn-success">Annehmen</button>
        </div>
    </li>
}
@code {

}
