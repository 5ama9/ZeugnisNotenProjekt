@using Web.Services;
@using Microsoft.AspNetCore.Authorization

@page "/protector"

@attribute [Authorize]
@inject IGradeService GradeService

<title>Anfragen</title>

<h3>Anfragen</h3>

@foreach (var grade in grades)
    {
    <li class="row listItem align-items-center justify-content-between">
        <div class="col-2">
            {
                <strong class="">@grade.CreatorName</strong>
            <div class="col-2">
                <p>@grade.FirstName @grade.LastName</p>
            </div>
            <div class="col-2">
                <p>@grade.Class</p>
            </div>
            <div class="col-2">
                <p>@grade.Subject</p>
            </div>
            <div class="col-2">
                <p>@grade.Grade</p>
            </div>

                <button class="btn btn-sm btn-primary" >Ablehnen</button>
                <button class="btn btn-sm btn-primary" >Annehmen</button>
            }
        </div>
    </li>
    }
@code {

}
