@using Shared.Models.DTOs
@using Web.Services;
@using Microsoft.AspNetCore.Authorization

@page "/prorector"

@attribute [Authorize]
@inject IGradeService GradeService

<title>Anfragen</title>

<h3>Anfragen</h3>

@foreach (GradeDto grade in grades)
{
    <li class="row mb-4 listItem align-items-center justify-content-between">
        <div class="row">
            <div class="col-2">
                <strong>@grade.CreatorName</strong>
            </div>

            <div class="col-2">
                <p>Schüler/in: @grade.FirstName @grade.LastName</p>
            </div>

            <div class="col-2">
                <p>Klasse: @grade.Class</p>
            </div>

            <div class="col-2">
                <p>Fach: @grade.Subject</p>
            </div>

            <div class="col-2">
                <p>Note: @grade.Grade</p>
            </div>

            <div class="col-2">
               @*  <button class="btn btn-sm btn-third" @onclick="() => StatusDecline(todo.Id)">Ablehnen</button>
                <button class="btn btn-sm btn-primary" @onclick="() => StatusAccept(todo.Id)">Annehmen</button> *@
                <button class="btn btn-sm btn-third">Ablehnen</button>
                <button class="btn btn-sm btn-primary">Annehmen</button>
            </div>
        </div>
        <div class="row">
            <div class="col-2"></div>
            <p class="col-6">Bemerkung: @grade.Remark</p>
        </div>
    </li>
}

