@using Web.Services;

@page "/login"

@inject IAuthService AuthService

<title>Login</title>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="login-wrapper listItem">
        <div class="login-card">
            <div class="text-center">
                <h3 class="mb-3">Login</h3>
            </div>
        <InputText @bind-Value="loginModel.Email" placeholder="Email" class="form-control mb-2 custom-input" />
        <ValidationMessage For="@(() => loginModel.Email)" />

        <InputText @bind-Value="loginModel.Password" placeholder="Password" class="form-control mb-3 custom-input" />
        <ValidationMessage For="@(() => loginModel.Password)" />

            <div class="text-center">
                <button type="submit" class="btn btn-primary mt-2">Login</button>
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">
                    @_errorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class=" alert alert-success">
                    @_successMessage
                </div>
            }
        </div>
    </div>
</EditForm>



